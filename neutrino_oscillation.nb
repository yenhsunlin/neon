     RowBox[{"Sqrt", "[", "2", "]"}], "*", "GF", "*", 
     RowBox[{"10", "^", 
      RowBox[{"solarElectronNumberDensity", "[", "x", "]"}]}], "*", "NA", "*",
      "perVoltoElectronVoltCubic", "*", "eVtoInverseKm"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "potential", " ", "from", " ", "electron", " ", "in", " ", "the", " ", 
    "sun", " ", "and", " ", "convert", " ", "from", " ", "eV", " ", "to", " ", 
    RowBox[{"1", "/", "km"}]}], "*)"}]}]}], "Input",
