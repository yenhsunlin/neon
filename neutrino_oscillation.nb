Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"HamiltonianFlavor", "[", 
    RowBox[{"energy_", ",", "\[Theta]_", ",", "\[CapitalDelta]m2_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", GridBox[{
       {
        RowBox[{"-", 
         RowBox[{"Cos", "[", 
          RowBox[{"2", "\[Theta]"}], "]"}]}], 
        RowBox[{"Sin", "[", 
