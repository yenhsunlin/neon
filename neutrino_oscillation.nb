Cell[BoxData[
 RowBox[{
  RowBox[{"HamiltonianFlavor2", "[", 
   RowBox[{"energy_", ",", "\[Theta]_", ",", "\[CapitalDelta]m2_"}], "]"}], ":=", 
  RowBox[{
   FractionBox["1", 
    RowBox[{"2", "*", "energy"}]], 
   RowBox[{
    RowBox[{"(", GridBox[{
       {
        RowBox[{"Cos", "[", "\[Theta]", "]"}], 
        RowBox[{"Sin", "[", "\[Theta]", "]"}]},
       {
        RowBox[{"-", 
         RowBox[{"Sin", "[", "\[Theta]", "]"}]}], 
        RowBox[{"Cos", "[", "\[Theta]", "]"}]}
      }], ")"}], ".", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{"m1", "^", "2"}], "0"},
       {"0", 
        RowBox[{"m2", "^", "2"}]}
      }], ")"}], ".", 
    RowBox[{"Transpose", "[", 
     RowBox[{"(", GridBox[{
        {
