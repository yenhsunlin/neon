       {
        RowBox[{"Sin", "[", 
         RowBox[{"2", "\[Theta]"}], "]"}], 
        RowBox[{"Cos", "[", 
         RowBox[{"2", "\[Theta]"}], "]"}]}
      }], ")"}], "*", 
    FractionBox[
     RowBox[{"\[CapitalDelta]m2", " "}], 
     RowBox[{"4", "*", "energy", "*", 
      RowBox[{"10", "^", "6", " ", 
       RowBox[{"(*", 
        RowBox[{"convert", " ", "to", " ", "eV"}], "*)"}]}]}]], "*", 
    "eVtoInverseKm"}]}], 
  RowBox[{"(*", 
   RowBox[{
